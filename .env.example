# The only required variable. Create a key in the Meta Model API dashboard.
MODEL_API_KEY=

# Optional overrides (defaults shown). See docs/meta-api-notes.md.
# META_BASE_URL=https://api.meta.ai/v1
# SIFT_VISION_MODEL=muse-spark-1.3
# SIFT_TEXT_MODEL=muse-spark-1.3
# SIFT_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Optional: run text-only calls on open-weight Muse Spark Open via Baseten.
# SIFT_OPEN_WEIGHT_TEXT=false
# BASETEN_API_KEY=
# SIFT_OPEN_WEIGHT_MODEL=meta-models/muse-spark-open-1026

# Offline development only: fake, deterministic model output (the UI shows a MOCK badge).
# SIFT_MOCK_META=false
